# Maintainer: <your name> <your email>
#
# Community-maintained AUR reference for nftui. nftui's own release pipeline
# does NOT publish to the AUR — this is a starting point for an Arch community
# maintainer. It is a "-bin" package: it installs the prebuilt binary from the
# GitHub release rather than compiling from source.
#
# To publish / update on the AUR:
#   1. bump pkgver to the new release,
#   2. refresh the checksums:  updpkgsums
#   3. regenerate .SRCINFO:     makepkg --printsrcinfo > .SRCINFO
#   4. push to ssh://aur@aur.archlinux.org/nftui-bin.git
#
# Arch users who don't use the AUR can instead install the native package
# attached to every GitHub release directly, no PKGBUILD needed:
#   sudo pacman -U nftui_<version>_linux_x86_64.pkg.tar.zst

pkgname=nftui-bin
pkgver=1.1.0
pkgrel=1
pkgdesc="Terminal user interface for managing the Linux nftables firewall"
arch=('x86_64' 'aarch64')
url="https://github.com/aafeher/nftui"
license=('MIT')
depends=('nftables')
provides=('nftui')
conflicts=('nftui')
source_x86_64=("nftui-${pkgver}-x86_64.tar.gz::${url}/releases/download/v${pkgver}/nftui_${pkgver}_linux_amd64.tar.gz")
source_aarch64=("nftui-${pkgver}-aarch64.tar.gz::${url}/releases/download/v${pkgver}/nftui_${pkgver}_linux_arm64.tar.gz")
# Pin these to the published v1.1.0 release tarballs with `updpkgsums` once the
# release exists; the digests cannot be known before it publishes. Do NOT publish
# to the AUR while they read SKIP.
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
	install -Dm755 nftui "${pkgdir}/usr/bin/nftui"
	install -Dm644 man/nftui.1 "${pkgdir}/usr/share/man/man1/nftui.1"
	install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
	install -Dm644 CHANGELOG.md "${pkgdir}/usr/share/doc/${pkgname}/CHANGELOG.md"
}
